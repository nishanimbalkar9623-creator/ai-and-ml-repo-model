# Environment Configuration Template

# Gemini AI API Key (optional - for AI insights)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database Connection (SQLite by default)
# PostgreSQL: postgresql://username:password@localhost:5432/invoice_db
# SQLite: sqlite:///data/invoice.db
DATABASE_URL=sqlite:///data/invoice.db

# Flask Server Config
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production
PORT=8002